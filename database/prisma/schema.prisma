// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AttendeeEvent {
  id         String @id @default(uuid()) @db.Uuid
  eventId    String @map("event_id") @db.Uuid
  attendeeId String @map("attendee_id") @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  event    Event    @relation(fields: [eventId], references: [id])
  attendee Attendee @relation(fields: [attendeeId], references: [id])

  @@map("attendee_event")
}

model Attendee {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  cellphone String   @db.VarChar(18)
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  notifications  Notification[]
  attendeeEvents AttendeeEvent[]

  @@map("attendee")
}


model Event {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  date        DateTime @db.Timestamptz
  place       String   @db.VarChar(255)
  ticketMax   Int      @map("ticket_max")
  ticketsLeft Int      @map("tickets_left")
  ticketSold  Int      @map("ticket_sold")
  typeId        String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  eventType EventType @relation(fields: [typeId], references: [id])
  ticketEvents   TicketEvent[]
  attendeeEvents AttendeeEvent[]

  @@map("event")
}

model EventType {
  id  String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  events Event[]
  @@map("event_type")
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  message    String   @db.Text
  sendDate   DateTime @map("send_date") @db.Timestamptz
  attendeeId String   @map("attendee_id") @db.Uuid
  type       String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  attendee         Attendee         @relation(fields: [attendeeId], references: [id])
  notificationType NotificationType @relation(fields: [type], references: [id])

  @@map("notification")
}

model NotificationType {
  id   String @id @default(uuid()) @db.Uuid
  type String @db.VarChar
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  notifications Notification[]

  @@map("notification_type")
}

model TicketEvent {
  id           String  @id @default(uuid()) @db.Uuid
  eventId      String? @map("event_id") @db.Uuid
  ticketEvent  String? @map("ticket_event") @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  event Event? @relation(fields: [eventId], references: [id])

  @@map("ticket_event")
}

model Ticket {
  id    String  @id @default(uuid()) @db.Uuid
  price Decimal @db.Decimal
  typeId  String  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  ticketType TicketType @relation(fields: [typeId], references: [id])

  @@map("ticket")
}

model TicketType {
  id   String @id @default(uuid()) @db.Uuid
  type String @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  tickets Ticket[]

  @@map("ticket_type")
}

